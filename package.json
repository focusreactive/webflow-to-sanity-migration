{
  "name": "webflow-to-sanity-migration",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.34.4",
  "imports": {
    "#adapters/*": "./src/adapters/*",
    "#assets/*": "./src/scripts/assets/*",
    "#blocks/*": "./src/scripts/blocks/*",
    "#detect/*": "./src/scripts/detect/*",
    "#discovery/*": "./src/scripts/discovery/*",
    "#generate/*": "./src/scripts/generate/*",
    "#globals/*": "./src/scripts/globals/*",
    "#harness/*": "./src/scripts/harness/*",
    "#init-project/*": "./src/scripts/init-project/*",
    "#inventory/*": "./src/scripts/inventory/*",
    "#ir/*": "./src/ir/*",
    "#layout/*": "./src/scripts/layout/*",
    "#lib/*": "./src/lib/*",
    "#probe/*": "./src/scripts/probe/*",
    "#replay/*": "./src/scripts/replay/*",
    "#run-config/*": "./src/run-config/*",
    "#snapshot/*": "./src/scripts/snapshot/*",
    "#synth/*": "./src/scripts/synth/*",
    "#tokens/*": "./src/scripts/tokens/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests && tsc --noEmit -p src/harness",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "generate:schemas": "tsx src/generate-schemas/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/block-tools": "^3.70.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/culori": "4.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cheerio": "^1.2.0",
    "culori": "4.0.2",
    "esbuild": "^0.27.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "playwright": "1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
